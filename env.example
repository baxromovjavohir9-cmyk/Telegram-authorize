# Nusxa oling: cp .env.example .env  — va qiymatlarni to'ldiring

# @BotFather bergan token
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Tasodifiy uzun matn. Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bu-yerga-tasodifiy-uzun-matn

PORT=3000

# Xabarda ko'rsatiladigan vaqt zonasi (ixtiyoriy)
# DISPLAY_TZ=Asia/Tashkent

# Serverda (HTTPS bilan) ishlatganda:
# NODE_ENV=production
